{
  "name": "remora",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @remora/desktop tauri dev",
    "build": "pnpm --filter @remora/desktop build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "design:lint": "npx -y @google/design.md@0.3.0 lint DESIGN.md"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11"
  },
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=24"
  }
}
